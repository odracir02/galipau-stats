// Worker de la API de GalipauStats (Cloudflare Workers + D1).
// Ver docs/BACKEND.md. La base de datos de preview ya está creada en Cloudflare
// (jurisdicción UE); la de production todavía no, y su identificador es un
// marcador hasta que se cree.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Nombre propio del entorno local: un «deploy» sin --env nunca puede
  // sustituir al Worker de producción.
  "name": "galipau-stats-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  // Sin URLs de vista previa por versión: serían otra forma de llegar al Worker.
  "preview_urls": false,

  // Entorno local (wrangler dev / migraciones --local). No toca Cloudflare.
  "vars": {
    "ENVIRONMENT": "local",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173",
    // Sin Cloudflare Access en local: la administración queda desactivada (503).
    // No existe ningún modo que la salte.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD_ADMIN": "",
    "ACCESS_AUD_CRITICAL": "",
    // Desactivadas hasta verificar el segundo factor en Cloudflare (ver docs).
    "ADMIN_CRITICAL_OPS": "disabled"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "galipau-stats-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "env": {
    // Pruebas: lo usará la vista previa de develop.
    "preview": {
      "name": "galipau-stats-api-preview",
      // Se publica en galipau-stats-api-preview.<subdominio>.workers.dev (sin dominio
      // propio). Las rutas /api/admin/* se protegerán con Cloudflare Access.
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "preview",
        "ALLOWED_ORIGINS": "https://develop.galipau-stats.pages.dev",
        // Se rellenan al crear las aplicaciones de Access (no son secretos).
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD_ADMIN": "",
        "ACCESS_AUD_CRITICAL": "",
        // Desactivadas hasta verificar el segundo factor en Cloudflare (ver docs).
        "ADMIN_CRITICAL_OPS": "disabled"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "galipau-stats-preview",
          "database_id": "9efcbd78-45c7-4b7f-9c68-fd9782fcd642",
          "migrations_dir": "migrations"
        }
      ]
    },
    // Producción: lo usará main. Base de datos distinta de la de pruebas.
    "production": {
      "name": "galipau-stats-api",
      "vars": {
        "ENVIRONMENT": "production",
        "ALLOWED_ORIGINS": "https://galipau-stats.pages.dev",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD_ADMIN": "",
        "ACCESS_AUD_CRITICAL": "",
        // Desactivadas hasta verificar el segundo factor en Cloudflare (ver docs).
        "ADMIN_CRITICAL_OPS": "disabled"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "galipau-stats-production",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
